# Copy this file to `.dev.vars` for local `wrangler`/`next dev` development.
# `.dev.vars` is gitignored — never commit real secrets.
#
# In production these are set with:
#   wrangler secret put ANTHROPIC_API_KEY
#   wrangler secret put RECHAT_API_KEY
#   wrangler secret put RECHAT_MCP_URL

# Anthropic Messages API key, used by app/api/assistant/route.ts
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# ReChat CRM credentials, used by lib/rechat.ts (currently stubbed)
RECHAT_API_KEY=
RECHAT_MCP_URL=
