# Copy this file to `.dev.vars` for local `wrangler`/`next dev` development.
# `.dev.vars` is gitignored — never commit real secrets.
#
# In production these are set with:
#   wrangler secret put ANTHROPIC_API_KEY
#   wrangler secret put RECHAT_LEAD_CHANNEL_ID

# Anthropic Messages API key, used by app/api/assistant/route.ts
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Rechat Lead Capture channel UUID (Rechat > Settings > Lead Routing >
# Lead Channels), used by lib/rechat.ts to POST new leads to
# https://api.rechat.com/leads/channels/{id}/webhook
RECHAT_LEAD_CHANNEL_ID=
