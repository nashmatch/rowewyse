{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rowewyse-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Static assets produced by the OpenNext build (JS/CSS/images/etc.)
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // --- D1: primary datastore for leads / newsletter signups ---
  // Create with: wrangler d1 create rowewyse-leads
  // Paste the returned database_id below, then run `npm run db:migrate:remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rowewyse-leads",
      "database_id": "77ea4c45-c861-4d3d-88ba-61d7d5bd3321"
    }
  ],

  // --- KV: chat widget session cache + rate limiting ---
  // Create with: wrangler kv namespace create CHAT_KV
  //              wrangler kv namespace create RATE_LIMIT_KV
  "kv_namespaces": [
    {
      "binding": "CHAT_KV",
      "id": "62ef104bd1de4726ba56103cc818554f"
    },
    {
      "binding": "RATE_LIMIT_KV",
      "id": "1776551ac5ca41cfb0150c36337739ac"
    }
  ],

  // --- R2: future home for real property photography + headshots ---
  // Uncomment once the client's media bucket is ready.
  // Create with: wrangler r2 bucket create rowewyse-media
  // "r2_buckets": [
  //   {
  //     "binding": "MEDIA",
  //     "bucket_name": "rowewyse-media"
  //   }
  // ],

  // --- Cron Trigger (future): retry any leads that failed to sync to Rechat ---
  // Uncomment once ready — lib/rechat.ts's sendLeadToRechat() is already a
  // real network call, this would just retry rows where synced_to_rechat = 0.
  // "triggers": {
  //   "crons": ["*/15 * * * *"]
  // },

  // Secrets (ANTHROPIC_API_KEY, RECHAT_LEAD_CHANNEL_ID) are NOT set here.
  // Production: `wrangler secret put ANTHROPIC_API_KEY`
  //             `wrangler secret put RECHAT_LEAD_CHANNEL_ID`
  // Local dev:  create a `.dev.vars` file (see .dev.vars.example)
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://rowewyse.com"
  }
}
